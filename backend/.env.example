# AVOCARD backend 환경변수 예시 파일입니다.
# 실제 값은 이 파일이 아니라 .env.local 에만 넣으세요. .env.local 은 git에 커밋되지 않습니다.
# 이 파일(.env.example)에는 절대 실제 API Key / Secret / Token 값을 채우지 마세요.

# --- Server ---
NODE_ENV=                      # development | test | production
PORT=                          # 예: 4000
LOG_LEVEL=                     # trace | debug | info | warn | error

# --- Database ---
DATABASE_URL=                  # 예: postgresql://user:password@localhost:5432/avocard_platform

# --- Admin 세션 ---
ADMIN_SESSION_SECRET=          # 관리자 세션 서명용 임의의 긴 문자열(32바이트 이상 권장). 코드/문서에 직접 적지 말 것.

# --- CORS (Admin SPA origin) ---
ADMIN_APP_ORIGIN=              # 예: http://localhost:5173 (Vite dev 서버)

# --- Shopify 고객 세션 검증 ---
# 운영환경(NODE_ENV=production)에서는 SHOPIFY_AUTH_MODE가 dev-stub 이면 서버가 부팅되지 않습니다.
# 실제 운영용 검증 방식(App Proxy 서명 검증 등)이 확정되기 전까지는 개발환경에서만 dev-stub을 사용하세요.
SHOPIFY_AUTH_MODE=             # dev-stub (개발 전용) | 실제 어댑터 이름(추후 확정)
SHOPIFY_SHOP_DOMAIN=           # 예: avocard.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=  # Storefront API public token (필요 시)
SHOPIFY_APP_PROXY_SHARED_SECRET=  # App Proxy 방식 채택 시 필요 (현재 미확정)

# --- 1688 API (현재 어댑터는 stub, 값 없어도 서버는 부팅됩니다) ---
# gw.open.1688.com 서명 규칙: urlPath + 알파벳 정렬된 파라미터(key+value 연속 결합) 문자열을
# HMAC-SHA1(secretKey)로 서명 후 hex 대문자. OAuth 토큰 교환/갱신은 별도 POST 엔드포인트 사용.
ALIBABA_1688_BASE_URL=          # 예: https://gw.open.1688.com
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
# 메인계정 OAuth 인가 후 발급된 값(1회성 code로 교환). 만료 시 refresh_token으로 갱신.
ALIBABA_1688_MAIN_ACCESS_TOKEN=
ALIBABA_1688_MAIN_REFRESH_TOKEN=
# 연동 대상 1688 子账号(서브계정)의 memberId와, subaccount.auth.add/list로 확인한 서브계정 access_token.
ALIBABA_1688_SUB_ACCOUNT_MEMBER_ID=
ALIBABA_1688_SUB_ACCOUNT_ACCESS_TOKEN=

# --- 중판(Jungpan/배송대행) API ---
# 33개 엔드포인트 API Guide 원본 및 테스트 서버 접속정보는 사용자가 별도로 전달합니다.
# GET(조회) 계열 엔드포인트부터 검증하고, POST(쓰기) 계열은 실행 대상/영향 확인 후 진행하세요.
JUNGPAN_BASE_URL=              # 예: https://test-api.example.com
JUNGPAN_SITE_CD=               # AVOCARD 전용 X-SITE-CD
JUNGPAN_API_KEY=               # X-API-KEY

# --- 채널톡 (알림, 현재 어댑터는 stub) ---
CHANNEL_TALK_API_KEY=
