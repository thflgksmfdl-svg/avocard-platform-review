                        await isEnded;
                        gkt.gktVideoMsg.state.elements.gktVideoPlayerRecording[0].load();
                        gkt.gktVideoMsg.state.elements.gktVideoPlayerControls.removeClass("gktVideoPlayerHide");
                        
                    } catch (error) {
