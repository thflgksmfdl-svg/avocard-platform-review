    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Certificate image"
        },
        {
          "type": "text",
          "id": "badge_icon",
          "label": "Badge icon name",
          "default": "check-circle"
        },
        {
          "type": "text",
          "id": "badge_label",
          "label": "Badge label",
          "default": "1688 공식 인증"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1688 슈퍼 바이어"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Annual Elite Customer · 超级买家"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "1688이 공식 인정한 슈퍼 바이어입니다. 일반 계정과 차별화된 최상위 등급으로, 공식 채널을 통한 안전한 직거래와 단가 협상을 제공합니다."
        },
        {
          "type": "text",
          "id": "number_label",
          "label": "Number label (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avocard certification",
      "blocks": [
        {
          "type": "certificate",
          "settings": {
            "badge_icon": "check-circle",
            "badge_label": "1688 공식 인증",
            "title": "1688 슈퍼 바이어",
            "subtitle": "Annual Elite Customer · 超级买家",
            "description": "1688이 공식 선정한 슈퍼 바이어입니다.\n일반 계정은 받을 수 없는 최상위 등급으로,\n안전한 거래와 단가 혜택을 보장합니다."
          }
        },
        {
          "type": "certificate",
          "settings": {
            "badge_icon": "shield",
            "badge_label": "정부 공인",
            "title": "벤처확인기업",
            "subtitle": "Venture Enterprise · 중판 주식회사",
            "description": "벤처기업확인기관이 인증한 혁신 성장유형\n벤처확인기업입니다. 정부가 검증한 기업이\n직접 운영하는 서비스입니다.",
            "number_label": "벤처확인번호 20260506030073"
          }
