{%- style -%}
  #section-{{ section.id }} {
    --guide-green: #0eaa50;
    --guide-green-dark: #08783a;
    --guide-green-deep: #063b25;
    --guide-green-soft: #eaf8ef;
    --guide-green-pale: #f7fcf8;
    --guide-lime: #d8f45b;
    --guide-orange: #ff6b1a;
    --guide-orange-soft: #fff4eb;
    --guide-ink: #111927;
    --guide-muted: #5f6d7b;
    --guide-line: #dfe8e3;
    --guide-page: #f5f8f6;
    --guide-white: #fff;
    --guide-shadow: 0 18px 48px rgba(17, 67, 39, 0.075);
    --guide-container: 1120px;
  }

  #section-{{ section.id }} * {
    box-sizing: border-box;
  }

  #section-{{ section.id }} {
    scroll-behavior: smooth;
    color: var(--guide-ink);
    background: var(--guide-page);
    font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", "Apple SD Gothic Neo", sans-serif;
    word-break: keep-all;
  }

  #section-{{ section.id }}.modal-open {
    overflow: hidden;
  }

  #section-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #section-{{ section.id }} button {
    font: inherit;
  }

  .avocard-guide-container {
    width: min(calc(100% - 40px), var(--guide-container));
    margin: 0 auto;
  }

  .avocard-guide-hero {
    padding: 88px 0 66px;
    color: #fff;
    background:
      radial-gradient(circle at 86% 12%, rgba(216, 244, 91, 0.18), transparent 28%),
      radial-gradient(circle at 8% 92%, rgba(65, 213, 132, 0.16), transparent 30%),
      linear-gradient(135deg, #0d9248 0%, #08713a 56%, #05381f 100%);
  }

  .avocard-guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 35px;
    padding: 7px 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 14px;
    font-weight: 850;
    backdrop-filter: blur(10px);
  }

  .avocard-guide-badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--guide-lime);
    box-shadow: 0 0 0 5px rgba(216, 244, 91, 0.12);
  }

  .avocard-guide-hero h1 {
    margin: 24px 0 14px;
    font-size: clamp(42px, 5vw, 66px);
    line-height: 1.08;
    letter-spacing: -0.06em;
    font-weight: 950;
  }

  .avocard-guide-hero h1 span {
    color: var(--guide-lime);
  }

  .avocard-guide-hero p {
    margin: 0;
    max-width: 760px;
    color: rgba(240, 255, 246, 0.84);
    font-size: 18px;
    line-height: 1.8;
    letter-spacing: -0.02em;
  }

  .avocard-guide-nav-wrap {
    margin-top: -22px;
  }

  .avocard-guide-nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    overflow: hidden;
    border: 1px solid var(--guide-line);
    border-radius: 20px;
    background: #fff;
    box-shadow: var(--guide-shadow);
  }

  .avocard-guide-nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 66px;
    padding: 14px;
    border-right: 1px solid var(--guide-line);
    color: #43505f;
    font-size: 14px;
    font-weight: 850;
    text-align: center;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .avocard-guide-nav a:last-child {
    border-right: 0;
  }

  .avocard-guide-nav.four-steps {
    grid-template-columns: repeat(4, 1fr);
  }

  .avocard-guide-nav a:hover {
    color: var(--guide-green-dark);
    background: var(--guide-green-pale);
  }

  .avocard-guide-nav-num {
    color: var(--guide-green);
    font-weight: 950;
  }

  .avocard-guide-main {
    padding: 54px 0 96px;
  }

  .avocard-guide-browser-note {
    margin-bottom: 28px;
    padding: 18px 22px;
    border: 1px solid rgba(14, 170, 80, 0.16);
    border-radius: 18px;
    color: #52606f;
    background: var(--guide-green-soft);
    font-size: 15px;
    line-height: 1.75;
  }

  .avocard-guide-browser-note strong {
    color: var(--guide-green-dark);
    font-weight: 900;
  }

  .avocard-guide-steps {
    display: grid;
    gap: 28px;
  }

  .avocard-guide-step {
    scroll-margin-top: 100px;
    overflow: hidden;
    border: 1px solid var(--guide-line);
    border-radius: 26px;
    background: #fff;
    box-shadow: var(--guide-shadow);
  }

  .avocard-guide-step-header {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 32px;
    border-bottom: 1px solid var(--guide-line);
    background: radial-gradient(circle at 96% 0%, rgba(216, 244, 91, 0.17), transparent 27%), linear-gradient(135deg, #f8fff9 0%, #eff9f3 100%);
  }

  .avocard-guide-step-no {
    min-width: 78px;
    color: var(--guide-green);
    font-size: 54px;
    line-height: 1;
    letter-spacing: -0.07em;
    font-weight: 950;
  }

  .avocard-guide-step.helper-step .avocard-guide-step-no {
    font-size: 24px;
    letter-spacing: -0.03em;
    min-width: 78px;
  }

  .avocard-guide-step-kicker {
    display: block;
    margin-bottom: 5px;
    color: var(--guide-green-dark);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  .avocard-guide-step-title {
    margin: 0;
    font-size: clamp(27px, 3vw, 39px);
    line-height: 1.25;
    letter-spacing: -0.05em;
    font-weight: 950;
  }

  .avocard-guide-step-content {
    padding: 30px 32px 34px;
  }

  .avocard-guide-step-copy p {
    margin: 0;
    color: var(--guide-muted);
    font-size: 17px;
    line-height: 1.95;
    letter-spacing: -0.018em;
  }

  .avocard-guide-step-copy p + p {
    margin-top: 14px;
  }

  .avocard-guide-step-copy strong {
    color: var(--guide-ink);
    font-weight: 900;
  }

  .avocard-guide-callout {
    display: inline-flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 18px;
    padding: 11px 14px;
    border-radius: 12px;
    color: var(--guide-green-dark);
    background: var(--guide-green-soft);
    font-size: 14px;
    line-height: 1.6;
    font-weight: 850;
  }

  .avocard-guide-callout.warning {
    color: #b94a10;
    background: var(--guide-orange-soft);
  }

  .avocard-guide-callout svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-top: 2px;
  }

  .avocard-guide-image {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 0;
    margin-top: 22px;
    border: 1px solid #d9e3dd;
    border-radius: 18px;
    background: #eef4f0;
    cursor: zoom-in;
    box-shadow: 0 12px 28px rgba(20, 72, 43, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .avocard-guide-image:hover {
    transform: translateY(-3px);
    border-color: rgba(14, 170, 80, 0.34);
    box-shadow: 0 18px 36px rgba(20, 72, 43, 0.1);
  }

  .avocard-guide-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .avocard-guide-zoom-label {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.58);
    border-radius: 999px;
    color: #fff;
    background: rgba(7, 59, 36, 0.84);
    font-size: 12px;
    font-weight: 850;
    backdrop-filter: blur(8px);
  }

  .avocard-guide-zoom-label svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avocard-guide-accordion {
    margin-top: 18px;
    border: 1px solid rgba(14, 170, 80, 0.18);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(18, 67, 39, 0.04);
    overflow: hidden;
  }

  .avocard-guide-accordion-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px;
    border: 0;
    background: var(--guide-green-pale);
    cursor: pointer;
    color: var(--guide-ink);
    text-align: left;
    font-weight: 900;
    font-size: 16px;
  }

  .avocard-guide-accordion-toggle small {
    display: block;
    margin-top: 4px;
    color: var(--guide-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .avocard-guide-accordion-toggle .icon {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    transition: transform 0.18s ease;
  }

  .avocard-guide-accordion-toggle[aria-expanded="true"] .icon {
    transform: rotate(180deg);
  }

  .avocard-guide-accordion-panel {
    display: none;
    padding: 20px;
  }

  .avocard-guide-accordion-panel.open {
    display: block;
  }

  .avocard-guide-accordion-note {
    margin: 0 0 16px;
    color: var(--guide-muted);
    font-size: 15px;
    line-height: 1.8;
  }

  .avocard-guide-copy-box {
    display: block;
    width: 100%;
    padding: 16px 18px;
    border: 1px dashed rgba(14, 170, 80, 0.4);
    border-radius: 14px;
    background: var(--guide-green-soft);
    color: var(--guide-green-deep);
    font-size: 15px;
    line-height: 1.9;
    font-weight: 850;
    cursor: pointer;
    text-align: left;
  }

  .avocard-guide-copy-box:hover {
    background: #e2f4e9;
  }

  .avocard-guide-copy-help {
    margin: 10px 0 0;
    color: #70808f;
    font-size: 13px;
    line-height: 1.6;
  }

  .avocard-guide-sub-image {
    margin-top: 16px;
  }

  .avocard-guide-copy-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%) translateY(20px);
    opacity: 0;
    padding: 12px 16px;
    border-radius: 999px;
    background: #0b1710;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.24);
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 10000;
  }

  .avocard-guide-copy-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .avocard-guide-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
    margin-top: 32px;
    padding: 32px 34px;
    border: 1px solid var(--guide-line);
    border-radius: 24px;
    background: #fff;
    box-shadow: var(--guide-shadow);
  }

  .avocard-guide-cta h2 {
    margin: 0 0 8px;
    font-size: 28px;
    letter-spacing: -0.04em;
  }

  .avocard-guide-cta p {
    margin: 0;
    color: var(--guide-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .avocard-guide-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
  }

  .avocard-guide-cta-btn {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 18px;
    border: 1px solid transparent;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 900;
    transition: transform 0.18s ease;
  }

  .avocard-guide-cta-btn:hover {
    transform: translateY(-2px);
  }

  .avocard-guide-cta-btn.primary {
    color: #fff;
    background: var(--guide-green);
    box-shadow: 0 13px 28px rgba(14, 170, 80, 0.18);
  }

  .avocard-guide-cta-btn.secondary {
    color: var(--guide-green-dark);
    border-color: rgba(14, 170, 80, 0.24);
    background: var(--guide-green-soft);
  }

  .avocard-guide-cta-btn svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avocard-guide-step-apply-cta {
    display: flex;
    justify-content: flex-start;
    margin-top: 24px;
  }

  .avocard-guide-step-apply-button {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 15px 22px;
    border-radius: 15px;
    color: #fff;
    background: var(--guide-green);
    font-size: 16px;
    font-weight: 900;
    box-shadow: 0 14px 30px rgba(14, 170, 80, 0.2);
    transition: transform 0.18s ease, filter 0.18s ease;
  }

  .avocard-guide-step-apply-button:hover {
    transform: translateY(-2px);
    filter: brightness(1.03);
  }

  .avocard-guide-step-apply-button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avocard-guide-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    place-items: center;
    padding: 28px;
    background: rgba(3, 17, 10, 0.86);
    backdrop-filter: blur(10px);
  }

  .avocard-guide-lightbox.is-open {
    display: grid;
  }

  .avocard-guide-lightbox-dialog {
    position: relative;
    max-width: min(90vw, 1200px);
    max-height: 90vh;
    width: 100%;
    background: #fff;
    border-radius: 28px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.3);
  }

  .avocard-guide-lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 32px;
    border-bottom: 1px solid var(--guide-line);
    background: var(--guide-page);
  }

  .avocard-guide-lightbox-title {
    font-size: 20px;
    font-weight: 900;
    color: var(--guide-ink);
  }

  .avocard-guide-lightbox-controls {
    display: flex;
    gap: 12px;
  }

  .avocard-guide-lightbox-control {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--guide-line);
    background: #fff;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .avocard-guide-lightbox-control:hover {
    background: var(--guide-green);
    color: #fff;
    border-color: var(--guide-green);
  }

  .avocard-guide-lightbox-control svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avocard-guide-lightbox-stage {
    flex: 1;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .avocard-guide-lightbox-stage img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .avocard-guide-nav {
      grid-template-columns: repeat(4, 1fr);
    }

    .avocard-guide-step-header {
      padding: 20px 24px;
    }

    .avocard-guide-step-no {
      font-size: 40px;
    }

    .avocard-guide-step-title {
      font-size: 24px;
    }

    .avocard-guide-step-content {
      padding: 24px;
    }

    .avocard-guide-cta {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .avocard-guide-cta-actions {
      justify-content: stretch;
    }

    .avocard-guide-cta-btn {
      flex: 1;
    }

    .avocard-guide-lightbox-dialog {
      border-radius: 20px;
    }

    .avocard-guide-lightbox-header {
      padding: 16px 20px;
    }

    .avocard-guide-lightbox-stage {
      padding: 16px;
    }
  }

  @media (max-width: 480px) {
    .avocard-guide-nav {
      grid-template-columns: 1fr;
    }

    .avocard-guide-nav a {
      min-height: 56px;
      font-size: 13px;
      padding: 10px;
    }

    .avocard-guide-hero {
      padding: 60px 0 40px;
    }

    .avocard-guide-hero h1 {
      font-size: 32px;
    }

    .avocard-guide-step-header {
      padding: 16px 20px;
    }

    .avocard-guide-step-no {
      font-size: 28px;
      min-width: 50px;
    }

    .avocard-guide-step-title {
      font-size: 18px;
    }

    .avocard-guide-step-content {
      padding: 16px 20px;
    }

    .avocard-guide-step-copy p {
      font-size: 15px;
    }

    .avocard-guide-copy-box {
      font-size: 13px;
      padding: 12px 16px;
    }

    .avocard-guide-step-apply-button {
      width: 100%;
    }
  }
{%- endstyle -%}

<div id="section-{{ section.id }}" class="avocard-guide-wrapper">
  <section class="avocard-guide-hero">
    <div class="avocard-guide-container">
      <div class="avocard-guide-badge">
        <span>{{ section.settings.guide_badge | escape }}</span>
      </div>
      <h1>{{ section.settings.guide_title | escape }}<span>{{ section.settings.guide_title_highlight | escape }}</span></h1>
      <p>{{ section.settings.guide_description | newline_to_br }}</p>

      <div class="avocard-guide-nav-wrap">
        <nav class="avocard-guide-nav">
          <a href="#step-1"><span class="avocard-guide-nav-num">{{ section.settings.nav_step1_num | escape }}</span> {{ section.settings.nav_step1_label | escape }}</a>
          <a href="#step-address"><span class="avocard-guide-nav-num">주소</span> {{ section.settings.nav_address_label | escape }}</a>
          <a href="#step-2"><span class="avocard-guide-nav-num">{{ section.settings.nav_step2_num | escape }}</span> {{ section.settings.nav_step2_label | escape }}</a>
          <a href="#step-3"><span class="avocard-guide-nav-num">{{ section.settings.nav_step3_num | escape }}</span> {{ section.settings.nav_step3_label | escape }}</a>
          <a href="#step-4"><span class="avocard-guide-nav-num">{{ section.settings.nav_step4_num | escape }}</span> {{ section.settings.nav_step4_label | escape }}</a>
        </nav>
      </div>
    </div>
  </section>

  <main class="avocard-guide-main">
    <div class="avocard-guide-container">
      <div class="avocard-guide-browser-note">
        ※ 본 가이드는 <strong>{{ section.settings.browser_note_title | escape }}</strong>를 기준으로 제작되었습니다.
      </div>

      <div class="avocard-guide-steps">
        <section class="avocard-guide-step" id="step-1">
          <header class="avocard-guide-step-header">
            <div class="avocard-guide-step-no">{{ section.settings.step1_number | escape }}</div>
            <div>
              <span class="avocard-guide-step-kicker">{{ section.settings.step1_kicker | escape }}</span>
              <h2 class="avocard-guide-step-title">{{ section.settings.step1_title | escape }}</h2>
            </div>
          </header>

          <div class="avocard-guide-step-content">
            <div class="avocard-guide-step-copy">
              <p>{{ section.settings.step1_description | newline_to_br }}</p>
            </div>
            <div class="avocard-guide-callout">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 9v4M12 17h.01"></path>
                <path d="M10.3 3.7 2.8 17a2 2 0 0 0 1.74 3h14.92a2 2 0 0 0 1.74-3L13.7 3.7a2 2 0 0 0-3.4 0Z"></path>
              </svg>
              <span>{{ section.settings.step1_callout | escape }}</span>
            </div>
            <div class="avocard-guide-image" data-title="{{ section.settings.step1_image_alt | escape }}">
              <img
                src="{{ 'usage-guide-step-1.webp' | asset_url }}"
                alt="{{ section.settings.step1_image_alt | escape }}"
                width="1896"
                height="829"
                loading="lazy"
              >
              <div class="avocard-guide-zoom-label">
                <svg viewBox="0 0 24 24">
                  <path d="M8 8l-3.5-3.5M3 21l3-3m0-3a8 8 0 1 1 0-16 8 8 0 0 1 0 16z"></path>
                </svg>
                {{ section.settings.zoom_label | escape }}
              </div>
            </div>
          </div>
        </section>

        <section class="avocard-guide-step helper-step" id="step-address">
          <header class="avocard-guide-step-header">
            <div class="avocard-guide-step-no">?</div>
            <div>
              <span class="avocard-guide-step-kicker">{{ section.settings.address_kicker | escape }}</span>
              <h2 class="avocard-guide-step-title">{{ section.settings.address_title | escape }}</h2>
            </div>
          </header>

          <div class="avocard-guide-step-content">
            <div class="avocard-guide-accordion">
              <button class="avocard-guide-accordion-toggle" type="button" aria-expanded="false" aria-controls="addressPanel">
                {{ section.settings.address_accordion_title | escape }}
                <small>{{ section.settings.address_accordion_subtitle | escape }}</small>
                <span class="icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </button>
              <div class="avocard-guide-accordion-panel" id="addressPanel">
