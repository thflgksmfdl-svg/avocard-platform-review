<script>
  (function() {
    const sectionId = 'section-{{ section.id }}';
    const sectionEl = document.getElementById(sectionId);

    if (!sectionEl) return;

    const items = [...sectionEl.querySelectorAll('.avocard-guide-image')];
    const lightbox = sectionEl.querySelector('#lightbox');
    const stage = sectionEl.querySelector('#lightboxStage');
    const title = sectionEl.querySelector('#lightboxTitle');
    const closeButton = sectionEl.querySelector('#closeButton');
    const prevButton = sectionEl.querySelector('#prevButton');
    const nextButton = sectionEl.querySelector('#nextButton');
    const accordionBtn = sectionEl.querySelector('.avocard-guide-accordion-toggle');
    const accordionPanel = sectionEl.querySelector('#addressPanel');
    const copyBox = sectionEl.querySelector('.avocard-guide-copy-box');
    const copyToast = sectionEl.querySelector('#copyToast');

    let currentIndex = 0;
    let lastFocusedElement = null;
    let initialized = false;

    function renderItem(index) {
      if (items.length === 0) return;
      const item = items[index];
      const image = item.querySelector('img');
      const enlargedImage = document.createElement('img');
      title.textContent = item.dataset.title || '가이드 이미지';
      stage.innerHTML = '';
      enlargedImage.src = image.currentSrc || image.src;
      enlargedImage.alt = image.alt;
      stage.appendChild(enlargedImage);
    }

    function openLightbox(index) {
      currentIndex = index;
      lastFocusedElement = document.activeElement;
      renderItem(currentIndex);
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      sectionEl.classList.add('modal-open');
      closeButton.focus();
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      sectionEl.classList.remove('modal-open');
      if (lastFocusedElement) lastFocusedElement.focus();
    }

    function showPrevious() {
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      renderItem(currentIndex);
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % items.length;
      renderItem(currentIndex);
    }

    function showToast(message) {
      copyToast.textContent = message;
      copyToast.classList.add('show');
      clearTimeout(showToast._timer);
      showToast._timer = setTimeout(() => copyToast.classList.remove('show'), 1800);
    }

    function init() {
      if (initialized) return;
      initialized = true;

      items.forEach((item, index) => {
        item.addEventListener('click', () => openLightbox(index));
      });

      closeButton.addEventListener('click', closeLightbox);
      prevButton.addEventListener('click', showPrevious);
      nextButton.addEventListener('click', showNext);

      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (event) => {
        if (!lightbox.classList.contains('is-open')) return;
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowLeft') showPrevious();
        if (event.key === 'ArrowRight') showNext();
      });

      if (accordionBtn) {
        accordionBtn.addEventListener('click', () => {
          const expanded = accordionBtn.getAttribute('aria-expanded') === 'true';
          accordionBtn.setAttribute('aria-expanded', String(!expanded));
          accordionPanel.classList.toggle('open', !expanded);
        });
      }

      if (copyBox) {
        copyBox.addEventListener('click', async () => {
          const value = copyBox.dataset.copy;
          try {
            await navigator.clipboard.writeText(value);
            showToast('주소가 복사되었습니다.');
          } catch (e) {
            const temp = document.createElement('textarea');
            temp.value = value;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            temp.remove();
            showToast('주소가 복사되었습니다.');
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

