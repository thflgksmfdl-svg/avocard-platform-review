{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.82 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.82 | round: 0 }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="avocard avocard-band section-{{ section.id }}-padding">
  <div class="avocard-page">
    <div class="avocard-faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="avocard-faq__badge">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="avocard-faq__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="avocard-faq__list">
      {%- for block in section.blocks -%}
        <div class="avocard-faq__item" {{ block.shopify_attributes }}>
          <button type="button" class="avocard-faq__question">
            <span class="avocard-faq__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="avocard-faq__question-text">{{ block.settings.question | escape }}</span>
            <span class="avocard-faq__toggle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </span>
          </button>
          <div class="avocard-faq__answer-wrap">
            <div class="avocard-faq__answer-inner">
              <div class="avocard-faq__answer">{{ block.settings.answer }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="avocard-faq__footer">
      <div class="avocard-faq__footer-copy">
        <strong>더 궁금한 내용이 있으신가요?</strong>
        <span>전체 FAQ를 확인하거나 고객센터로 바로 문의해 주세요.</span>
      </div>
      <div class="avocard-faq__buttons">
        {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
          <a href="{{ section.settings.primary_link }}" class="avocard-faq__btn avocard-faq__btn--primary">
            {{ section.settings.primary_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a href="{{ section.settings.secondary_link }}" target="_blank" rel="noopener noreferrer" class="avocard-faq__btn avocard-faq__btn--secondary">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const buttons = document.querySelectorAll('.avocard-faq__question');
    buttons.forEach(button => {
      button.addEventListener('click', function() {
        const currentItem = this.closest('.avocard-faq__item');
        const allItems = currentItem.closest('.avocard-faq__list').querySelectorAll('.avocard-faq__item');

        allItems.forEach(item => {
          if (item !== currentItem) {
            item.classList.remove('is-open');
          }
        });

        currentItem.classList.toggle('is-open');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Avocard FAQ preview",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "수입대행, 자주 묻는 질문"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "전체 FAQ 보기"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "카카오톡 문의"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "질문을 입력하세요"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>답변을 입력하세요</p>"
