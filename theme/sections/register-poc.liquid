{{ 'register-poc.css' | asset_url | stylesheet_tag }}

<main class="av-register-page">
  <div class="av-register-shell">

    <div class="av-register-heading">
      <h1>회원가입</h1>
    </div>

    <section class="av-register-card">
      <form id="register-poc-form" novalidate>
        <div class="av-row">
          <div class="av-field">
            <label for="register-poc-last-name">성 <span class="av-required">*</span></label>
            <input class="av-input" id="register-poc-last-name" name="lastName" type="text" autocomplete="family-name" placeholder="홍" required>
            <span class="register-poc-error" data-error-for="lastName"></span>
          </div>

          <div class="av-field">
            <label for="register-poc-first-name">이름 <span class="av-required">*</span></label>
            <input class="av-input" id="register-poc-first-name" name="firstName" type="text" autocomplete="given-name" placeholder="길동" required>
            <span class="register-poc-error" data-error-for="firstName"></span>
          </div>
        </div>

        <div class="av-field">
          <label for="register-poc-email">이메일 <span class="av-required">*</span></label>
          <input class="av-input" id="register-poc-email" name="email" type="email" autocomplete="email" placeholder="example@email.com" required>
          <span class="register-poc-error" data-error-for="email"></span>
        </div>

        <div class="av-field">
          <label for="register-poc-phone">휴대폰번호 <span class="av-required">*</span></label>
          <input class="av-input" id="register-poc-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="01012345678" required>
          <p class="av-help">010으로 시작하는 휴대폰번호를 입력해주세요.</p>
          <span class="register-poc-error" data-error-for="phone"></span>
        </div>

        <div class="av-field">
          <label for="register-poc-password">비밀번호 <span class="av-required">*</span></label>
          <input class="av-input" id="register-poc-password" name="password" type="password" autocomplete="new-password" placeholder="비밀번호를 입력해주세요" required>
          <span class="register-poc-error" data-error-for="password"></span>
        </div>

        <div class="av-field">
          <label for="register-poc-password-confirmation">비밀번호 확인 <span class="av-required">*</span></label>
          <input class="av-input" id="register-poc-password-confirmation" name="passwordConfirmation" type="password" autocomplete="new-password" placeholder="비밀번호를 한 번 더 입력해주세요" required>
          <span class="register-poc-error" data-error-for="passwordConfirmation"></span>
        </div>

        <div class="av-honeypot" aria-hidden="true">
          <label for="register-poc-company">회사 홈페이지</label>
          <input id="register-poc-company" name="company_website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <input id="register-poc-loaded-at" type="hidden" value="">

        <span id="register-poc-global-error" class="register-poc-error"></span>
        <button id="register-poc-submit" type="submit" disabled>회원가입</button>
      </form>

      <div class="av-divider"></div>

      <div class="av-login-link">
        이미 계정이 있으신가요?
        <a href="/account/login">로그인</a>
      </div>
    </section>
  </div>
</main>

<script src="{{ 'register-poc.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'register-poc-ui.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "회원가입 폼",
  "settings": [],
  "presets": [
    {
      "name": "회원가입 폼"
    }
  ]
}
{% endschema %}
