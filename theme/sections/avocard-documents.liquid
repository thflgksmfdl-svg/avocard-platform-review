{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.82 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.82 | round: 0 }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="avocard avocard-band avocard-proof section-{{ section.id }}-padding">
  <div class="avocard-page">
    {%- render 'avocard-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.section_description,
      align: 'left'
    -%}

    <div class="avocard-proof__risk-banner">
      <strong>{{ section.settings.risk_title | escape }}</strong>
      <p>{{ section.settings.risk_text | escape }}</p>
    </div>

    <div class="avocard-proof__grid">
      {%- for block in section.blocks -%}
        <article class="avocard-proof__card" {{ block.shopify_attributes }}>
          <div class="avocard-proof__card-icon">
            {{ block.settings.icon_svg }}
          </div>
          <h3 class="avocard-proof__card-title">{{ block.settings.title | escape }}</h3>
          <p class="avocard-proof__card-text">{{ block.settings.text | escape }}</p>
          <div class="avocard-proof__card-footer">
            {%- if block.settings.sub_1 != blank -%}
              <span class="avocard-proof__card-sub">{{ block.settings.sub_1 | escape }}</span>
            {%- endif -%}
            {%- if block.settings.sub_2 != blank -%}
              <span class="avocard-proof__card-sub">{{ block.settings.sub_2 | escape }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="avocard-proof__video-cta">
      <div class="avocard-proof__video-content">
        <h3>{{ section.settings.video_title | escape }}</h3>
        <p>{{ section.settings.video_text | escape }}</p>
        {%- if section.settings.video_link != blank -%}
          <a href="{{ section.settings.video_link }}" target="_blank" rel="noopener noreferrer" class="avocard-proof__video-link">
            {{ section.settings.video_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.video_thumbnail != blank -%}
        {%- if section.settings.video_link != blank -%}
          <a
            href="{{ section.settings.video_link }}"
            target="_blank"
            rel="noopener noreferrer"
            class="avocard-proof__video-thumbnail"
            aria-label="{{ section.settings.video_label | escape }}"
          >
        {%- else -%}
          <div class="avocard-proof__video-thumbnail">
        {%- endif -%}
          <img
            src="{{ section.settings.video_thumbnail }}"
            alt="아보카드 수입 증빙 안내 영상 썸네일"
            loading="lazy"
          />
          <div class="avocard-proof__video-play-btn">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        {%- if section.settings.video_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
