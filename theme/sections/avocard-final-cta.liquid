{%- style -%}
  .section-{{ section.id }}-padding {
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom | times: 0.82 | round: 0 }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="avocard avocard-final-cta section-{{ section.id }}-padding" aria-labelledby="final-cta-title-{{ section.id }}">
  <div class="avocard-final-cta__inner">
    <span class="avocard-final-cta__badge">{{ section.settings.badge | escape }}</span>

    <h2 class="avocard-final-cta__title" id="final-cta-title-{{ section.id }}">
      {{ section.settings.heading | escape }}
    </h2>

    <p class="avocard-final-cta__description">
      {{ section.settings.description | escape }}
    </p>

    <div class="avocard-final-cta__actions">
      <a class="avocard-final-cta__button avocard-final-cta__button--secondary" href="{{ section.settings.guide_link }}" aria-label="{{ section.settings.guide_label | escape }}">
        {%- render 'avocard-icon', name: 'file-text', size: 20 -%}
        {{ section.settings.guide_label | escape }}
      </a>

      <a class="avocard-final-cta__button avocard-final-cta__button--quote" href="{{ section.settings.quote_link }}" aria-label="{{ section.settings.quote_label | escape }}">
        {%- render 'avocard-icon', name: 'arrow-right', size: 20 -%}
        {{ section.settings.quote_label | escape }}
      </a>
    </div>

    <div class="avocard-final-cta__trust" aria-label="아보카드 서비스 장점">
      {%- for block in section.blocks -%}
        <span class="avocard-final-cta__trust-item" {{ block.shopify_attributes }}>
          <span class="avocard-final-cta__trust-check" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8 2.6 2.6L12.5 4.5"/></svg>
          </span>
          {{ block.settings.label | escape }}
        </span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avocard final CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "지금 바로 시작하세요"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "써보는 게 제일 빠릅니다"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "수입대행 견적, 지금 바로 무료로 받아보세요"
    },
    {
      "type": "text",
      "id": "guide_label",
      "label": "Guide button label",
      "default": "견적 신청 방법"
    },
    {
      "type": "url",
      "id": "guide_link",
      "label": "Guide button link"
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Quote button label",
      "default": "수입대행 견적 신청하기"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "Quote button link"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "무료 견적"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avocard final CTA",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "label": "무료 견적"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "빠른 응답"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "투명한 수수료"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "label": "증빙 자료 완비"
          }
        }
      ]
    }
  ]
}
{% endschema %}
