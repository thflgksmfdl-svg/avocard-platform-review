{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.82 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.82 | round: 0 }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="avocard avocard-band avocard-band--category section-{{ section.id }}-padding">
  <div class="avocard-page">
    {%- render 'avocard-section-heading',
      heading: section.settings.heading,
      text: section.settings.text
    -%}

    <div class="avocard-category-grid">
      <article class="avocard-category-card avocard-category-card--compact">
        <p class="avocard-category-card__kicker">ABOUT 아보카드</p>
        <h3>처음이라면 여기부터 보세요</h3>
        <ul class="avocard-category-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.group == 'about' -%}
              <li {{ block.shopify_attributes }}>
                <a
                  {% if block.settings.link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.link }}"
                  {% endif %}
                >
                  <span>{{ block.settings.label | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <small>{{ block.settings.text | escape }}</small>
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </article>

      <article class="avocard-category-card avocard-category-card--primary">
        <p class="avocard-category-card__kicker">수입대행 신청/조회</p>
        <h3>신청하고, 진행상황까지 바로 확인하세요</h3>
        <ul class="avocard-category-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.group == 'order' -%}
              <li {{ block.shopify_attributes }}>
                <a
                  {% if block.settings.link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.link }}"
                  {% endif %}
                >
                  <span>{{ block.settings.label | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <small>{{ block.settings.text | escape }}</small>
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </article>

      <article class="avocard-category-card avocard-category-card--compact">
        <p class="avocard-category-card__kicker">고객센터</p>
        <h3>애매하면 먼저 물어보셔도 됩니다</h3>
        <ul class="avocard-category-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.group == 'support' -%}
              <li {{ block.shopify_attributes }}>
                <a
                  {% if block.settings.link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.link }}"
                  {% endif %}
                >
                  <span>{{ block.settings.label | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <small>{{ block.settings.text | escape }}</small>
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avocard category links",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "빠른 메뉴"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "필요한 메뉴를 바로 찾을 수 있게 정리했습니다"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>처음 이용하시는 분은 이용가이드부터, 바로 진행하실 분은 수입대행 신청/조회 메뉴를 이용해 주세요.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "Group",
          "options": [
            {
              "value": "about",
              "label": "ABOUT 아보카드"
            },
            {
              "value": "order",
              "label": "수입대행 신청/조회"
            },
            {
              "value": "support",
              "label": "고객센터"
            }
          ],
          "default": "about"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "이용가이드"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "처음 이용 전 확인해 주세요."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avocard category links",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "group": "about",
            "label": "아보카드 소개",
            "text": "아보카드가 어떤 서비스인지 확인해 보세요."
          }
        },
        {
          "type": "link",
          "settings": {
            "group": "about",
            "label": "이용가이드",
            "text": "처음 이용 전 진행 방법을 확인해 주세요."
          }
        },
        {
          "type": "link",
          "settings": {
            "group": "about",
            "label": "운영약관",
            "text": "주문 전 꼭 확인해야 할 기준입니다."
          }
        },
        {
          "type": "link",
          "settings": {
            "group": "order",
            "label": "수입대행 신청하기",
            "text": "상품 링크와 수량을 보내 견적을 요청하세요."
          }
        },
        {
          "type": "link",
          "settings": {
            "group": "order",
            "label": "주문/진행상황 조회",
            "text": "전용 주문페이지에서 진행상황을 확인하세요."
          }
        },
        {
          "type": "link",
          "settings": {
            "group": "support",
            "label": "자주하는 질문",
            "text": "이용 전 궁금한 내용을 먼저 확인해 보세요."
          }
        },
        {
          "type": "link",
          "settings": {
            "group": "support",
            "label": "카카오톡 1:1문의",
            "text": "통관, 인증, 입고 가능 여부가 애매하면 문의해 주세요."
          }
        }
      ]
    }
  ]
}
{% endschema %}
